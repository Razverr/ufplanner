# UF Planner Server Environment Configuration
PORT=5000

# PostgreSQL Connection String or Individual Parameters
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ufplanner
# Optional pooled connection for the running web server (recommended for Neon)
DATABASE_URL_POOLED=
PGPOOL_MAX=10

# Individual Parameters (used if DATABASE_URL is commented out)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ufplanner

# UF ONE.UF Schedule of Courses Endpoint
UF_SOC_API_URL=https://one.uf.edu/apix/soc/schedule/
UF_SOC_FILTERS_URL=https://one.uf.edu/apix/soc/filters

# Optional Neon Auth endpoint. Authentication is not required for the demo audit.
NEON_AUTH_BASE_URL=

# Required for degree-audit imports in production. Send as x-audit-import-token.
AUDIT_IMPORT_TOKEN=
